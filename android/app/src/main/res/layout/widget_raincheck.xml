<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_background_day">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_weather_icon"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:contentDescription="Weather" />

        <TextView
            android:id="@+id/widget_city"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Küçükçekmece"
            android:textColor="#F7F9FD"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="just now"
            android:textColor="#91A6C2"
            android:textSize="9sp"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_temperature"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="27°C"
            android:textColor="#F8FAFF"
            android:textSize="46sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_condition_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="Condition" />

                <TextView
                    android:id="@+id/widget_condition"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Clear"
                    android:textColor="#FFD166"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_feels"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Feels 26°C"
                android:textColor="#B4C1D3"
                android:textSize="11sp"
                android:maxLines="1" />

            <TextView
                android:id="@+id/widget_high_low"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="H 28°C  L 21°C"
                android:textColor="#93A5BC"
                android:textSize="10sp"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_detail_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_rain"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Rain 10%"
            android:textColor="#82C7FF"
            android:textSize="10sp"
            android:maxLines="1" />

        <TextView
            android:id="@+id/widget_wind"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Wind 12 km/h"
            android:textColor="#C4D2E4"
            android:textSize="10sp"
            android:maxLines="1" />

        <TextView
            android:id="@+id/widget_uv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="right"
            android:text="UV 6"
            android:textColor="#F1C96B"
            android:textSize="10sp"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_metrics_row"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="7dp"
        android:background="#2C4059" />

    <LinearLayout
        android:id="@+id/widget_hourly"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <LinearLayout android:id="@+id/hour1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:id="@+id/hour1_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Now" android:textColor="#93A5BC" android:textSize="9sp" android:maxLines="1" />
            <ImageView android:id="@+id/hour1_icon" android:layout_width="17dp" android:layout_height="17dp" android:layout_marginTop="3dp" android:contentDescription="Hour" />
            <TextView android:id="@+id/hour1_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="21°" android:textColor="#F8FAFF" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/hour2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:id="@+id/hour2_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2pm" android:textColor="#93A5BC" android:textSize="9sp" android:maxLines="1" />
            <ImageView android:id="@+id/hour2_icon" android:layout_width="17dp" android:layout_height="17dp" android:layout_marginTop="3dp" android:contentDescription="Hour" />
            <TextView android:id="@+id/hour2_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="21°" android:textColor="#F8FAFF" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/hour3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:id="@+id/hour3_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3pm" android:textColor="#93A5BC" android:textSize="9sp" android:maxLines="1" />
            <ImageView android:id="@+id/hour3_icon" android:layout_width="17dp" android:layout_height="17dp" android:layout_marginTop="3dp" android:contentDescription="Hour" />
            <TextView android:id="@+id/hour3_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="20°" android:textColor="#F8FAFF" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/hour4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:id="@+id/hour4_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4pm" android:textColor="#93A5BC" android:textSize="9sp" android:maxLines="1" />
            <ImageView android:id="@+id/hour4_icon" android:layout_width="17dp" android:layout_height="17dp" android:layout_marginTop="3dp" android:contentDescription="Hour" />
            <TextView android:id="@+id/hour4_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="19°" android:textColor="#F8FAFF" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/hour5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:id="@+id/hour5_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5pm" android:textColor="#93A5BC" android:textSize="9sp" android:maxLines="1" />
            <ImageView android:id="@+id/hour5_icon" android:layout_width="17dp" android:layout_height="17dp" android:layout_marginTop="3dp" android:contentDescription="Hour" />
            <TextView android:id="@+id/hour5_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="18°" android:textColor="#F8FAFF" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/hour6" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:id="@+id/hour6_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="6pm" android:textColor="#93A5BC" android:textSize="9sp" android:maxLines="1" />
            <ImageView android:id="@+id/hour6_icon" android:layout_width="17dp" android:layout_height="17dp" android:layout_marginTop="3dp" android:contentDescription="Hour" />
            <TextView android:id="@+id/hour6_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="17°" android:textColor="#F8FAFF" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_daily"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout android:id="@+id/day1" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/day1_name" android:layout_width="52dp" android:layout_height="wrap_content" android:text="Today" android:textColor="#F8FAFF" android:textSize="11sp" android:maxLines="1" />
            <ImageView android:id="@+id/day1_icon" android:layout_width="15dp" android:layout_height="15dp" android:contentDescription="Day" />
            <TextView android:id="@+id/day1_range" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="right" android:text="15° – 24°" android:textColor="#B4C1D3" android:textSize="11sp" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/day2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/day2_name" android:layout_width="52dp" android:layout_height="wrap_content" android:text="Tue" android:textColor="#F8FAFF" android:textSize="11sp" android:maxLines="1" />
            <ImageView android:id="@+id/day2_icon" android:layout_width="15dp" android:layout_height="15dp" android:contentDescription="Day" />
            <TextView android:id="@+id/day2_range" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="right" android:text="14° – 23°" android:textColor="#B4C1D3" android:textSize="11sp" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/day3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/day3_name" android:layout_width="52dp" android:layout_height="wrap_content" android:text="Wed" android:textColor="#F8FAFF" android:textSize="11sp" android:maxLines="1" />
            <ImageView android:id="@+id/day3_icon" android:layout_width="15dp" android:layout_height="15dp" android:contentDescription="Day" />
            <TextView android:id="@+id/day3_range" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="right" android:text="13° – 22°" android:textColor="#B4C1D3" android:textSize="11sp" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/day4" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/day4_name" android:layout_width="52dp" android:layout_height="wrap_content" android:text="Thu" android:textColor="#F8FAFF" android:textSize="11sp" android:maxLines="1" />
            <ImageView android:id="@+id/day4_icon" android:layout_width="15dp" android:layout_height="15dp" android:contentDescription="Day" />
            <TextView android:id="@+id/day4_range" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="right" android:text="12° – 21°" android:textColor="#B4C1D3" android:textSize="11sp" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/day5" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/day5_name" android:layout_width="52dp" android:layout_height="wrap_content" android:text="Fri" android:textColor="#F8FAFF" android:textSize="11sp" android:maxLines="1" />
            <ImageView android:id="@+id/day5_icon" android:layout_width="15dp" android:layout_height="15dp" android:contentDescription="Day" />
            <TextView android:id="@+id/day5_range" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="right" android:text="11° – 20°" android:textColor="#B4C1D3" android:textSize="11sp" android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
