<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:padding="10dp" android:gravity="center_vertical" android:orientation="horizontal" android:background="@drawable/widget_background_day">
    <ImageView android:id="@+id/widget_weather_icon" android:layout_width="30dp" android:layout_height="30dp" android:contentDescription="Weather" />
    <TextView android:id="@+id/widget_city" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="Küçükçekmece" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/widget_condition" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:text="Clear" android:textSize="10sp" android:textStyle="bold" android:maxLines="1" />
    <TextView android:id="@+id/widget_temperature" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="27°C" android:textSize="26sp" android:textStyle="bold" android:includeFontPadding="false" />













    <TextView android:id="@+id/widget_updated" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <ImageView android:id="@+id/widget_condition_icon" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <TextView android:id="@+id/widget_feels" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <TextView android:id="@+id/widget_high_low" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <LinearLayout android:id="@+id/widget_detail_row" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <TextView android:id="@+id/widget_rain" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <TextView android:id="@+id/widget_wind" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <TextView android:id="@+id/widget_uv" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <LinearLayout android:id="@+id/widget_metrics_row" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <LinearLayout android:id="@+id/widget_hourly" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone">
        <LinearLayout android:id="@+id/hour1" android:layout_width="1dp" android:layout_height="1dp"><TextView android:id="@+id/hour1_label" android:layout_width="1dp" android:layout_height="1dp"/><ImageView android:id="@+id/hour1_icon" android:layout_width="1dp" android:layout_height="1dp"/><TextView android:id="@+id/hour1_temp" android:layout_width="1dp" android:layout_height="1dp"/></LinearLayout>
        <LinearLayout android:id="@+id/hour2" android:layout_width="1dp" android:layout_height="1dp"><TextView android:id="@+id/hour2_label" android:layout_width="1dp" android:layout_height="1dp"/><ImageView android:id="@+id/hour2_icon" android:layout_width="1dp" android:layout_height="1dp"/><TextView android:id="@+id/hour2_temp" android:layout_width="1dp" android:layout_height="1dp"/></LinearLayout>
        <LinearLayout android:id="@+id/hour3" android:layout_width="1dp" android:layout_height="1dp"><TextView android:id="@+id/hour3_label" android:layout_width="1dp" android:layout_height="1dp"/><ImageView android:id="@+id/hour3_icon" android:layout_width="1dp" android:layout_height="1dp"/><TextView android:id="@+id/hour3_temp" android:layout_width="1dp" android:layout_height="1dp"/></LinearLayout>
        <LinearLayout android:id="@+id/hour4" android:layout_width="1dp" android:layout_height="1dp"><TextView android:id="@+id/hour4_label" android:layout_width="1dp" android:layout_height="1dp"/><ImageView android:id="@+id/hour4_icon" android:layout_width="1dp" android:layout_height="1dp"/><TextView android:id="@+id/hour4_temp" android:layout_width="1dp" android:layout_height="1dp"/></LinearLayout>
        <LinearLayout android:id="@+id/hour5" android:layout_width="1dp" android:layout_height="1dp"><TextView android:id="@+id/hour5_label" android:layout_width="1dp" android:layout_height="1dp"/><ImageView android:id="@+id/hour5_icon" android:layout_width="1dp" android:layout_height="1dp"/><TextView android:id="@+id/hour5_temp" android:layout_width="1dp" android:layout_height="1dp"/></LinearLayout>
        <LinearLayout android:id="@+id/hour6" android:layout_width="1dp" android:layout_height="1dp"><TextView android:id="@+id/hour6_label" android:layout_width="1dp" android:layout_height="1dp"/><ImageView android:id="@+id/hour6_icon" android:layout_width="1dp" android:layout_height="1dp"/><TextView android:id="@+id/hour6_temp" android:layout_width="1dp" android:layout_height="1dp"/></LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_daily" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone">
        <LinearLayout android:id="@+id/day1" android:layout_width="1dp" android:layout_height="1dp"><TextView android:id="@+id/day1_name" android:layout_width="1dp" android:layout_height="1dp"/><ImageView android:id="@+id/day1_icon" android:layout_width="1dp" android:layout_height="1dp"/><TextView android:id="@+id/day1_range" android:layout_width="1dp" android:layout_height="1dp"/></LinearLayout>
        <LinearLayout android:id="@+id/day2" android:layout_width="1dp" android:layout_height="1dp"><TextView android:id="@+id/day2_name" android:layout_width="1dp" android:layout_height="1dp"/><ImageView android:id="@+id/day2_icon" android:layout_width="1dp" android:layout_height="1dp"/><TextView android:id="@+id/day2_range" android:layout_width="1dp" android:layout_height="1dp"/></LinearLayout>
        <LinearLayout android:id="@+id/day3" android:layout_width="1dp" android:layout_height="1dp"><TextView android:id="@+id/day3_name" android:layout_width="1dp" android:layout_height="1dp"/><ImageView android:id="@+id/day3_icon" android:layout_width="1dp" android:layout_height="1dp"/><TextView android:id="@+id/day3_range" android:layout_width="1dp" android:layout_height="1dp"/></LinearLayout>
        <LinearLayout android:id="@+id/day4" android:layout_width="1dp" android:layout_height="1dp"><TextView android:id="@+id/day4_name" android:layout_width="1dp" android:layout_height="1dp"/><ImageView android:id="@+id/day4_icon" android:layout_width="1dp" android:layout_height="1dp"/><TextView android:id="@+id/day4_range" android:layout_width="1dp" android:layout_height="1dp"/></LinearLayout>
        <LinearLayout android:id="@+id/day5" android:layout_width="1dp" android:layout_height="1dp"><TextView android:id="@+id/day5_name" android:layout_width="1dp" android:layout_height="1dp"/><ImageView android:id="@+id/day5_icon" android:layout_width="1dp" android:layout_height="1dp"/><TextView android:id="@+id/day5_range" android:layout_width="1dp" android:layout_height="1dp"/></LinearLayout>
    </LinearLayout>
</LinearLayout>
